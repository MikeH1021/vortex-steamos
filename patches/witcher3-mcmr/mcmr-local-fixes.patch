+// local patch: "mcmdiag" in the console shows whether the mod's periodic
+// updates are running and what each follower is doing. "mcmfix" restarts
+// the timers and the follow behaviour.
+exec function mcmdiag()
+{
+	var scm : mod_scm;
+	var npcs : array<CNewNPC>;
+	var i : int;
+	var text : string;
+
+	scm = MCM_GetMCM();
+	if(!scm)
+	{
+		theGame.GetGuiManager().ShowNotification("MCM diag: no manager object", 20000.0);
+		return;
+	}
+	text = "MCM diag: quick ticks " + scm.quickTickCount + ", slow ticks " + scm.slowTickCount + ", stand-in ticks " + scm.fallbackTickCount
+		+ ", last quick " + FloatToStringPrec(theGame.GetEngineTimeAsSeconds() - scm.lastQuickTick, 1) + "s ago"
+		+ ", player state " + NameToString(thePlayer.GetCurrentStateName())
+		+ ", player speed " + FloatToStringPrec(thePlayer.GetMovingAgentComponent().GetSpeed(), 2)
+		+ " rel " + FloatToStringPrec(thePlayer.GetMovingAgentComponent().GetRelativeMoveSpeed(), 2);
+	theGame.GetNPCsByTag('GeraltsBFF', npcs);
+	for(i = 0; i < npcs.Size(); i += 1)
+	{
+		if(npcs[i].scmcc) text += "<br>" + npcs[i].scmcc.DiagLine();
+	}
+	LogChannel('ModSpawnCompanions', text);
+	theGame.GetGuiManager().ShowNotification(text, 30000.0);
+}
+
+exec function mcmfix()
+{
+	var npcs : array<CNewNPC>;
+	var i : int;
+
+	thePlayer.AddTimer('mod_scm_1second', 1, true, , , , true);
+	thePlayer.AddTimer('mod_scm_4second', 4, true, , , , true);
+	thePlayer.AddTimer('mod_scm_250msecond', 0.25, true, , , , true);
+	theGame.GetNPCsByTag('GeraltsBFF', npcs);
+	for(i = 0; i < npcs.Size(); i += 1)
+	{
+		if(npcs[i].scmcc && npcs[i].scmcc.IsFollowing()) npcs[i].scmcc.StartFollowing(true);
+	}
+	theGame.GetGuiManager().ShowNotification("MCM: timers and following restarted for " + npcs.Size() + " companions", 8000.0);
+}
+
+exec function mcmspeed()
+{
+	if(FactsQuerySum('mcm_local_speed_debug') > 0) FactsSet('mcm_local_speed_debug', 0);
+	else FactsSet('mcm_local_speed_debug', 1);
+}
