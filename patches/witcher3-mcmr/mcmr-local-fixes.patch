+// local patch: the mod's periodic updates (follower speed, catch-up teleport,
+// banter) hang off timers on the player. When those have stopped arriving,
+// a companion's own timer stands in for them.
+@addMethod(CNewNPC)
+timer function mcm_selfTick(dt : float, id : int)
+{
+    var scm : mod_scm;
+    var now : float;
+
+    if(!scmcc) return;
+    if(thePlayer && !thePlayer.mcmPlayerInitDone)
+    {
+        LogChannel('ModSpawnCompanions', "local patch: player start-up had not run, running it from a companion");
+        thePlayer.mcm_PlayerInit();
+    }
+    scm = MCM_GetMCM();
+    if(!scm) return;
+    now = theGame.GetEngineTimeAsSeconds();
+    if(now - scm.lastQuickTick > 0.6)
+    {
+        scm.fallbackTickCount += 1;
+        scm.timer250msecond();
+    }
+    if(now - scm.lastSlowTick > 6.0)
+    {
+        scm.timer4second();
+    }
+}
