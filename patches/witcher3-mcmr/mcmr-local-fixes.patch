+// On some setups that wrapper is never run when a save loads, which left the
+// mod with no periodic updates at all. It is now a method of its own, so a
+// companion can run it too (see mcm_selfTick in MCME_RemasteredNPCHooks.ws).
+@addField(CR4Player)
+public var mcmPlayerInitDone : bool;
+
 @wrapMethod(CR4Player)
 function OnSpawned(spawnData : SEntitySpawnData)
 {
     wrappedMethod(spawnData);
+    mcm_PlayerInit();
+}
+
+@addMethod(CR4Player)
+public function mcm_PlayerInit()
+{
+    var presentNpcs : array<CNewNPC>;
+    var p : int;
+
+    if(mcmPlayerInitDone) return;
+    mcmPlayerInitDone = true;
 
     if(!MODSCM_COMPANIONS)
     {
@@ -122,6 +140,23 @@
 
     LogChannel('ModSpawnCompanions', "Found Player: " + thePlayer + " when spawning " + this + ". Obj Equals: " + (thePlayer==this));
 
+    // local patch: the world-loaded pass removes every companion that is not on
+    // the saved follower list. When this start-up never ran in earlier sessions
+    // that list was never written, so companions who are following right now
+    // are put on it first.
+    if(MODSCM_COMPANIONS)
+    {
+        theGame.GetNPCsByTag('GeraltsBFF', presentNpcs);
+        for(p = 0; p < presentNpcs.Size(); p += 1)
