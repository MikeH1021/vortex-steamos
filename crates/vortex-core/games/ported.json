  {
    "id": "baldursgate3",
    "name": "Baldur's Gate 3",
    "steam": [
      1086940
    ],
    "executable": "bin/bg3_dx11.exe",
    "mod_path": {
      "base": "appdata_local",
      "path": "Larian Studios/Baldur's Gate 3/Mods"
    },
    "nexus_domain": "baldursgate3",
    "merge_mods": true,
    "targets": {
      "root": {
        "base": "game",
        "path": ""
      },
      "bin": {
        "base": "game",
        "path": "bin"
      },
      "data": {
        "base": "game",
        "path": "Data"
      },
      "se_config": {
        "base": "appdata_local",
        "path": "Larian Studios/Baldur's Gate 3/Script Extender"
      }
    },
    "install": [
      {
        "type": "flat",
        "ext": [
          ".dll"
        ],
        "target": "bin",
        "when": {
          "has_file": [
            "DWrite.dll"
          ]
        }
      },
      {
        "type": "anchor",
        "dirs": [
          "Script Extender",
          "SE_CONFIG"
        ],
        "keep": false,
        "target": "se_config"
      },
      {
        "type": "anchor",
        "dirs": [
          "bin"
        ],
        "keep": true,
        "target": "root"
      },
      {
        "type": "anchor",
        "dirs": [
          "Data"
        ],
        "keep": false,
        "target": "data",
        "when": {
          "has_dir": [
            "Public",
            "Generated"
          ]
        }
      },
      {
        "type": "anchor",
        "dirs": [
          "Public",
          "Generated",
          "Mods",
          "Localization"
        ],
        "keep": true,
        "target": "data",
        "when": {
          "has_dir": [
            "Public",
            "Generated"
          ]
        }
      },
      {
        "type": "anchor",
        "dirs": [
          "Data"
        ],
        "keep": false,
        "target": "data",
        "when": {
          "no_ext": [
            ".pak"
          ]
        }
      },
      {
        "type": "flat",
        "ext": [
          ".pak"
        ],
        "when": {
          "has_file": [
            "ModFixer.pak"
          ]
        }
      },
      {
        "type": "marker",
        "ext": [
          ".pak"
        ],
        "up": 0,
        "keep_folder": false
      }
    ],
    "notes": "After installing, switch each mod on in the game's own Mod Manager on the main menu, because this app does not write the game's mod list or load order. Mods are placed in the Windows version's folders, so the game has to be run through Proton. The Script Extender only loads when the game's Steam launch options are set to WINEDLLOVERRIDES=\"DWrite=n,b\" %command%."
  },
