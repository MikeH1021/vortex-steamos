[
  {
    "id": "7daystodie",
    "name": "7 Days to Die",
    "steam": [
      251570
    ],
    "executable": "7DaysToDie.exe",
    "native_executable": "7DaysToDie.x86_64",
    "mod_path": {
      "base": "game",
      "path": "Mods"
    },
    "nexus_domain": "7daystodie",
    "merge_mods": true,
    "targets": {
      "root": {
        "base": "game",
        "path": ""
      }
    },
    "install": [
      {
        "type": "as_is",
        "strip_wrapper": true,
        "target": "root",
        "when": {
          "has_dir": [
            "BepInEx"
          ],
          "has_file": [
            "winhttp.dll"
          ]
        }
      },
      {
        "type": "anchor",
        "dirs": [
          "BepInEx",
          "Mods"
        ],
        "keep": true,
        "target": "root",
        "when": {
          "has_dir": [
            "BepInEx"
          ]
        }
      },
      {
        "type": "marker",
        "file": [
          "ModInfo.xml"
        ],
        "up": 0,
        "keep_folder": true
      }
    ],
    "notes": "The game loads mods in alphabetical order of their folder names inside the Mods folder."
  },
