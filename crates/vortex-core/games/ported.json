  {
    "id": "darksouls2",
    "name": "Dark Souls II",
    "steam": [
      236430,
      335300
    ],
    "executable": "Game/DarksoulsII.exe",
    "mod_path": {
      "base": "game",
      "path": ""
    },
    "nexus_domain": "darksouls2",
    "merge_mods": true,
    "install": [
      {
        "type": "marker",
        "file": [
          "dinput8.dll"
        ],
        "up": 0,
        "keep_folder": false,
        "to": "Game"
      },
      {
        "type": "marker",
        "file": [
          "dxgi.dll",
          "d3d11.dll",
          "d3d9.dll",
          "d3d12.dll",
          "winmm.dll",
          "version.dll",
          "ds2sc_launcher.exe"
        ],
        "up": 0,
        "keep_folder": false,
        "to": "Game"
      },
      {
        "type": "flat",
        "ext": [
          "enc_regulation.bnd.dcx"
        ],
        "to": "Game",
        "when": {
          "no_ext": [
            ".dll",
            ".exe",
            ".dds",
            ".png",
            ".bnd",
            ".ini"
          ]
        }
      },
      {
        "type": "flat",
        "ext": [
          ".dds",
          ".png"
        ],
        "to": "Game/tex_override",
        "when": {
          "has_ext": [
            ".dds"
          ],
          "no_ext": [
            ".dll",
            ".exe",
            ".dcx",
            ".bnd",
            ".ini"
          ]
        }
      }
    ],
    "notes": "Texture mods are placed in Game/tex_override and only show up in the game when a texture loader such as DS2 Lighting Engine is installed."
  },
