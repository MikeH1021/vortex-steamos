[
  {
    "id": "skyrimse",
    "name": "Skyrim Special Edition",
    "steam": [
      489830
    ],
    "executable": "SkyrimSE.exe",
    "mod_path": {
      "base": "game",
      "path": "Data"
    },
    "nexus_domain": "skyrimspecialedition",
    "kind": "bethesda",
    "targets": {
      "root": {
        "base": "game",
        "path": ""
      }
    },
    "plugins": {
      "format": "asterisk",
      "app_dir": "Skyrim Special Edition",
      "native": [
        "skyrim.esm",
        "update.esm",
        "dawnguard.esm",
        "hearthfires.esm",
        "dragonborn.esm",
        "ccBGSSSE002-ExoticArrows.esl",
        "ccBGSSSE003-Zombies.esl",
        "ccBGSSSE004-RuinsEdge.esl",
        "ccBGSSSE006-StendarsHammer.esl",
        "ccBGSSSE007-Chrysamere.esl",
        "ccBGSSSE010-PetDwarvenArmoredMudcrab.esl",
        "ccBGSSSE014-SpellPack01.esl",
        "ccBGSSSE019-StaffofSheogorath.esl",
        "ccBGSSSE021-LordsMail.esl",
        "ccMTYSSE001-KnightsoftheNine.esl",
        "ccQDRSSE001-SurvivalMode.esl",
        "ccTWBSSE001-PuzzleDungeon.esm",
        "ccEEJSSE001-Hstead.esl"
      ],
      "ccc": "Skyrim.ccc",
      "extensions": [
        ".esm",
        ".esp",
        ".esl"
      ]
    },
    "extender": {
      "name": "SKSE64",
      "loader": "skse64_loader.exe"
    },
    "notes": "SKSE64 installs like any mod: download it from Nexus Mods and this app puts its loader next to the game. Steam still starts the game's own launcher. To start the game through SKSE64, set the game's launch options in Steam to: bash -c 'exec \"${@/SkyrimSELauncher.exe/skse64_loader.exe}\"' -- %command%"
  },
